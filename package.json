{
  "name": "reservly",
  "version": "1.0.0",
  "private": true,
  "description": "Flexible reservation platform for service businesses, cafés, and more",
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend db:studio",
    "start": "pnpm --filter backend start",
    "test": "pnpm --filter backend test",
    "test:frontend": "pnpm --filter backend exec tsx --test ../../packages/frontend/src/widget/razorpayDisplay.test.ts ../../packages/frontend/src/dashboard/geolocation.test.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}