# Base URL of the SlotBook API as seen by the customer's browser.
#
# - Local development: leave empty. The vite dev server proxies /api to the
#   backend (see vite.config.ts) so relative '/api' works.
# - Split-host deploy (Vercel static + external Node API): set this to the full
#   API origin, e.g. https://api.slotbook.example  (no trailing slash).
# - Single-service deploy (backend also serves the built frontend): leave empty.
#
# WARNING: VITE_* variables are inlined into the JS bundle and visible in the
# browser. Never put API secrets (JWT_SECRET, CRON_SECRET, Razorpay, Cloudinary,
# SMTP, Twilio) here — those stay on the server in the backend .env.
VITE_API_BASE_URL=
