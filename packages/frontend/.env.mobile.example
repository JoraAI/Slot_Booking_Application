# Copy values into packages/frontend/.env before `pnpm mobile:sync`
# (or export for a one-off build). These are baked into the JS bundle.

# Required for Android/iOS — public API origin (Render example):
VITE_API_BASE_URL=https://reservly-api.onrender.com

# Optional; Google Sign-In is web-only in the native shell.
VITE_GOOGLE_CLIENT_ID=
