# Reference for PRODUCTION Render env (branch `main` / reservly-api).
# Set these in the Render dashboard — do not commit real secrets.
# Never run `pnpm db:seed` against this database.

RESERVLY_ENV=production

# Neon project: reservly-prod (pooled + direct)
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="prod-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=10000
FRONTEND_URL="https://YOUR-PROD-VERCEL.vercel.app"
FRONTEND_PUBLIC_URL="https://YOUR-PROD-VERCEL.vercel.app"
CORS_ORIGINS=""
CRON_SECRET="prod-cron-secret"

# Platform Razorpay — LIVE mode keys only (rzp_live_…)
# Wallet top-up + owner subscriptions on production.
RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"

RESEND_API_KEY=""
RESEND_FROM="Reservly <noreply@yourdomain.com>"

WHATSAPP_PROVIDER="gupshup"
GUPSHUP_API_KEY=""
GUPSHUP_APP_NAME="ReservlyWhatsappIndNum"
GUPSHUP_APP_ID="e3a6417f-4a8d-4194-9d77-144d2821c0c8"
GUPSHUP_SOURCE="919553539060"
GUPSHUP_DISPLAY_PHONE="+91 95535 39060"
GUPSHUP_TEMPLATE_UTILITY="b89e841f-71c5-4079-9649-27a03218e8ba"
# appointment_confirmation_3 (contact in {2} sample) — APPROVED
GUPSHUP_TEMPLATE_BOOKING="2fdadf21-4b7d-4096-90fc-5c4d65119754"
GUPSHUP_TEMPLATE_MARKETING=""

GOOGLE_CLIENT_ID=""
