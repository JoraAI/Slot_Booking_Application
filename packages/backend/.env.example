# --- Core ---
# Docker Compose in this repo maps host 5433 -> container 5432
# (avoids collisions with another local Postgres on 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/slot_booking"
# Neon production:
# - DATABASE_URL = pooled host (...-pooler...) with ?sslmode=require&pgbouncer=true (app + wallet tx)
# - DIRECT_URL   = direct host (same project, WITHOUT -pooler) with ?sslmode=require (migrations only)
# Prisma uses DIRECT_URL for migrate deploy so PgBouncer cannot strand advisory locks (P1002).
# For local Docker Postgres, set DIRECT_URL to the same value as DATABASE_URL:
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/slot_booking"
# Neon pooled URL (production) must end with pgbouncer=true so Prisma interactive
# transactions (refund/wallet) stay pinned to one connection:
# DATABASE_URL="postgresql://...@host-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://...@host.region.aws.neon.tech/db?sslmode=require"
JWT_SECRET="change-me-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:5173"
FRONTEND_PUBLIC_URL="http://localhost:5173"
CRON_SECRET="change-me-random-string"

# --- Owner SMTP (per-salon, saved in Settings, encrypted in DB) ---
# Optional platform fallback if an owner has not saved SMTP yet:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Reservly"

# Optional extra key for encrypting owner SMTP secrets at rest.
# If unset, JWT_SECRET is used.
# CREDENTIALS_ENCRYPTION_KEY=""

# --- Shared platform WhatsApp (Reservly-owned) ---
# Salons do NOT paste credentials. They Enable WhatsApp + top up wallet.
# Switch transport without code changes (default meta):
# WHATSAPP_PROVIDER="meta"
# WHATSAPP_PROVIDER="twilio"

# Meta Cloud API (used when WHATSAPP_PROVIDER=meta)
# META_WHATSAPP_PHONE_NUMBER_ID=""
# META_WHATSAPP_ACCESS_TOKEN=""
# META_WHATSAPP_DISPLAY_PHONE="+91XXXXXXXXXX"
# META_WHATSAPP_TEMPLATE_UTILITY=""
# META_WHATSAPP_TEMPLATE_MARKETING=""
# META_APP_ID=""
# META_APP_SECRET=""
# META_WEBHOOK_VERIFY_TOKEN=""
# META_API_VERSION="v20.0"

# Twilio WhatsApp (used when WHATSAPP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# TWILIO_WHATSAPP_DISPLAY_PHONE="+14155238886"
# Content Template SIDs (approved in Twilio Content / WhatsApp):
# TWILIO_WHATSAPP_CONTENT_SID_UTILITY=""
# TWILIO_WHATSAPP_CONTENT_SID_MARKETING=""

# --- Razorpay (optional; third-party costs apply) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Subscription trial grace ---
# Trial businesses should not be paused (availability/booking stay enabled)
# until this many days after `business.createdAt`.
SUBSCRIPTION_TRIAL_DAYS="14"

# --- Cloudinary (unused for new uploads) ---
# Images are stored in Postgres (`MediaAsset`) and served at /api/media/:id.
# These vars are optional leftovers and are not required for owner uploads.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER_PREFIX="reservly-dev"

# --- WhatsApp multi-tenant prepaid wallet ---
# Wallet per-message pricing is DB-managed (WhatsAppPricing) per provider
# (meta vs twilio) at ≈1.6× wholesale. Editable via
# POST /api/internal/whatsapp-pricing with CRON_SECRET.

# --- Owner Google Sign-In (optional) ---
# Owner auth OTP emails (signup + forgot-password) use the platform SMTP above;
# SMTP_USER / SMTP_PASS must be set for those emails to send.
GOOGLE_CLIENT_ID=""
# Only needed if you later add a server-side Google redirect flow; GIS ID-token
# verify only requires GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_SECRET=""
