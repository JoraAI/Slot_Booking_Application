# --- Core ---
# Docker Compose in this repo maps host 5433 -> container 5432
# (avoids collisions with another local Postgres on 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/slot_booking"
JWT_SECRET="change-me-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:5173"
FRONTEND_PUBLIC_URL="http://localhost:5173"
CRON_SECRET="change-me-random-string"

# --- SMTP (email notifications; optional) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Reservly"

# --- Twilio WhatsApp + SMS (optional; third-party costs apply) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_SMS_FROM=""

# --- Razorpay (optional; third-party costs apply) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Cloudinary media (optional) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER_PREFIX="reservly-dev"
