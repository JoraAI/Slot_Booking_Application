# Copy to packages/backend/.env when working against the DEMO Neon project.
# Used by the `demo` Git branch / reservly-api-demo on Render.
# Never point this file at the production Neon project.

RESERVLY_ENV=demo

# Neon project: reservly-demo (pooled + direct)
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="demo-change-me-separate-from-prod"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="https://YOUR-DEMO-VERCEL.vercel.app"
FRONTEND_PUBLIC_URL="https://YOUR-DEMO-VERCEL.vercel.app"
CORS_ORIGINS=""
CRON_SECRET="demo-cron-secret-separate-from-prod"

# Platform Razorpay — TEST mode keys only (rzp_test_…)
# Wallet top-up + owner subscriptions on the demo API.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"

# Email / WhatsApp — can share with prod or use test credentials
RESEND_API_KEY=""
RESEND_FROM="Reservly Demo <beth.t@example.com>"

WHATSAPP_PROVIDER="gupshup"
GUPSHUP_API_KEY=""
GUPSHUP_APP_NAME="ReservlyWhatsappIndNum"
GUPSHUP_APP_ID="e3a6417f-4a8d-4194-9d77-144d2821c0c8"
GUPSHUP_SOURCE="919553539060"
GUPSHUP_DISPLAY_PHONE="+91 95535 39060"
GUPSHUP_TEMPLATE_UTILITY="b89e841f-71c5-4079-9649-27a03218e8ba"
# appointment_confirmation_3 (contact in {2} sample) — APPROVED
GUPSHUP_TEMPLATE_BOOKING="2fdadf21-4b7d-4096-90fc-5c4d65119754"
GUPSHUP_TEMPLATE_MARKETING=""

GOOGLE_CLIENT_ID=""
SUBSCRIPTION_TRIAL_DAYS="14"

# Invoice WhatsApp template UUID (Header = Document; body {{1}}–{{4}})
GUPSHUP_TEMPLATE_INVOICE="7ae15c22-3478-455e-98f6-bfdef5d758f4"
